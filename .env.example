# Dominio público del despliegue; sin él se desactiva la indexación.
NEXT_PUBLIC_SITE_URL=
# Galería: conservar los valores del proyecto de Supabase existente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: configuración anterior del servidor; jamás usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Cuenta profesional de Instagram. Renovar el token antes de que expire.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Opcionales; solo se necesita Cloudinary si se usa CloudinaryImage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Contacto mediante Resend: remitente de un dominio verificado.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=isusedia@gmail.com

# Instagram Login por defecto; usar facebook si el token es de Facebook Login.
INSTAGRAM_LOGIN_TYPE=instagram
INSTAGRAM_API_VERSION=v25.0
