{
  "name": "productos-tajiri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "instagram:check": "node --experimental-strip-types scripts/check-instagram.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.372.0",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
